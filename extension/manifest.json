{
  "manifest_version": 3,
  "name": "Lumina Web Clipper",
  "version": "0.1.0",
  "description": "Clip the page you are reading into your Lumina vault, as Markdown, on your own machine.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Clip to Lumina",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Clip to Lumina"
    }
  }
}
